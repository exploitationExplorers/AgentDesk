# 微信群聊日报默认关闭；仅在本机安装私有 skill 后显式开启。
AGENTDESK_WECHAT_REPORT_ENABLED=false

# 可选：指定技能目录（不会随公开安装包分发）。
# AGENTDESK_SKILLS_DIR=D:/private/agentdesk-skills

# 可选：本地数据目录，包含数据库、密钥和浏览器登录态，请勿提交或分发。
# AGENTDESK_DATA_DIR=D:/private/agentdesk-data

# AI API Key、GitHub / Gitee / GitLab Token 请在应用设置中添加。
# 请勿放进 VITE_* 变量，Vite 会将这些变量编译进前端。
