{
  "name": "@agentdesk/cli",
  "version": "0.1.0",
  "description": "AgentDesk CLI: local agent runtime, service management and terminal chat",
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "agentdesk": "dist/index.mjs"
  },
  "files": [
    "dist",
    "TERMINAL.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "prepack": "tsx scripts/build.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.tools.json",
    "test:dist": "node --import tsx test/interactive-dist-smoke.ts",
    "test:package": "node --import tsx test/package-smoke.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "playwright-core": "^1.56.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@agentdesk/shared": "workspace:*",
    "@agentdesk/sidecar": "workspace:*",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.18.10",
    "@types/react": "19.3.0",
    "@voidzero-dev/vite-plus-prompts": "1.4.0",
    "esbuild": "^0.25.11",
    "ink-testing-library": "^4.0.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.3"
  }
}
