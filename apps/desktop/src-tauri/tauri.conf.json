{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentDesk",
  "version": "0.1.0",
  "identifier": "com.agentdesk.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentDesk",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2RjFDOEYzMTMyMjlGQ0IKUldUTG55SVQ4OGp4QnU2UEY4NkVXT2FuZFE0YW1JV0lFa21hNHZPM3JMNlllSXRYRW8vdUtpalgK",
      "endpoints": ["https://github.com/your-name/agentdesk/releases/latest/download/latest.json"]
    }
  }
}
